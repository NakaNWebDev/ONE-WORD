doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title いちにちひとこと
    //- Bootstrap 5 のCSS
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    //- Bootstrap Icons
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css")
    //- 作ったCSS
    link(rel="stylesheet" href="/style.css")
    //- ファビコン
    link(rel="icon" href="/favicon.ico")

  body
    header
      h1 いちにちひとこと
      p 今日という一日を「ひとこと」に。
        i.bi.bi-buildings.ms-2
        i.bi.bi-building-fill.ms-1
        i.bi.bi-buildings.ms-1
        i.bi.bi-building-fill.ms-1
        i.bi.bi-house-door.ms-1
        i.bi.bi-building-fill.ms-1
        i.bi.bi-house-fill.ms-1
        i.bi.bi-buildings.ms-1
        i.bi.bi-building-fill.ms-1
        i.bi.bi-buildings.ms-1
        i.bi.bi-building-fill.ms-1
        i.bi.bi-house-door.ms-1
        i.bi.bi-building-fill.ms-1
        i.bi.bi-house-fill.ms-1

      nav.navbar(style="background-color: #8b5cf6; color: white;")
        div.container
          a.navbar-brand.fw-bold.text-white(href="/posts") いちにちひとこと
          div.d-flex.align-items-center.gap-3
            span#current-time.text-white.small
            span.text-white #{user} でログイン中
            a.btn.btn-outline-light.btn-sm(href="/logout") ログアウト

    main
      section.post-section
        div(class="d-flex justify-content-center mt-3")
          h4 一日の終わりに「ひとこと」を残そう
          //押しピンアイコン
          div(class="d-flex justify-content-end mt-2")
          i.bi.bi-pin-angle-fill
          i.bi.bi-pin-angle-fill
          i.bi.bi-pin-angle-fill

        form(action="/posts" method="POST")
          input(type="hidden", name="oneTimeToken" value=oneTimeToken)
          div.mb-3
            label.form-label(for="date") 日付
            div.d-flex.align-items-center.gap-2
              input.form-control(type="date" id="date" name="date" required)
              button.btn.rounded-circle.d-inline-flex.align-items-center.justify-content-center(type="button" onclick="document.getElementById('date').showPicker()" style="width: 40px; height: 40px; background-color: #8b5cf6; border-color: #8b5cf6; color: white; flex-shrink: 0;")
                i.bi.bi-calendar-fill

          div.mt-3
            label.form-label(for="message")
              div(class="d-flex justify-content-center px-3.pb-3")
                i.bi.bi-chat-dots-fill.me-2
                | 今日のひとこと
                i.bi.bi-cup-hot-fill.ms-2
            input.form-control(type="text" id="message" name="message" placeholder="今日はどんなことがあった？ここに記入してね✍" maxlength="50" required)

          //記録するボタン（飛行機アイコン）
          div(class="d-flex justify-content-end px-3.pb-3")
            button.btn.rounded-circle.d-inline-flex.align-items-center.justify-content-center(type="submit", style="width: 40px; height: 40px; background-color: #8b5cf6; border-color: #8b5cf6; color: white;")
              i.bi.bi-send-fill

      section(class="history-section")
        h4 これまでの一言
        each post in contents
          div.card.my-3
            div.card-body
              div.d-flex.justify-content-between
                span.fw-bold #{post.date}
                small.text-muted ひとこと記入者: #{post.postedBy}
              p.card-text.mt-2 #{post.message}
            - const isDeletable = (user === post.postedBy || user === 'admin')
            if isDeletable
              div.d-flex.justify-content-end.px-3.pb-3
                form(method="post" action="/posts/delete")
                  input(type="hidden" name="id" value=post.id)
                  input(type="hidden" name="oneTimeToken" value=oneTimeToken)
                  button.btn.rounded-circle.d-inline-flex.align-items-center.justify-content-center(type="submit" style="width: 40px; height: 40px; background-color: #8b5cf6; border-color: #8b5cf6; color: white;")
                    i.bi.bi-trash

    footer
      div(class="d-flex justify-content-center align-items-center gap-2 mt-3")
        i.bi.bi-buildings
        i.bi.bi-house-heart-fill
        i.bi.bi-building-fill
        p.mb-0 一日一言 - 小さな思い出を残そう
        i.bi.bi-buildings
        i.bi.bi-house-heart-fill
        i.bi.bi-building-fill
        i.bi.bi-house-door
        i.bi.bi-building-fill
        i.bi.bi-house-fill

    script(src="/one-word.js")